@page
@model Hr_System.Pages.Account.LoginModel
@{
    ViewData["Title"] = "تسجيل الدخول";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h2>تسجيل الدخول</h2>
        
        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <strong>✓ نجاح!</strong> @Model.SuccessMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <strong>✗ خطأ!</strong> @Model.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
            <script>
                alert('@Model.ErrorMessage');
            </script>
        }
        
        <div class="alert alert-info mb-3">
            <h5>الحسابات التجريبية:</h5>
            <hr/>
            <p><strong>المدير الرئيسي:</strong><br/>
            اسم المستخدم: <code>admin</code><br/>
            كلمة المرور: <code>Admin2026!</code><br/>
            <em>صلاحيات: كاملة</em></p>
            <hr/>
            <p><strong>مدير قسم التنمية:</strong><br/>
            اسم المستخدم: <code>devadmin</code><br/>
            كلمة المرور: <code>P@ssw0rd123!</code><br/>
            <em>صلاحيات: كاملة</em></p>
            <hr/>
            <p><strong>مساعد تنمية:</strong><br/>
            اسم المستخدم: <code>devassistant</code><br/>
            كلمة المرور: <code>Employee2026!</code><br/>
            <em>صلاحيات: محدودة (عرض وإضافة وحذف فقط)</em></p>
            <hr/>
            <p><strong>المعلوماتية:</strong><br/>
            اسم المستخدم: <code>informatics</code><br/>
            كلمة المرور: <code>Informatics2026!</code><br/>
            <em>صلاحيات: كاملة، يمكن إدارة الحسابات وتفعيل/تعطيلها</em></p>
            <hr/>
            <p><strong>مستخدم العرض:</strong><br/>
            اسم المستخدم: <code>demo_viewer</code><br/>
            كلمة المرور: <code>Viewer2026!</code><br/>
            <em>صلاحيات: عرض الموظفين والمرفقات فقط</em></p>
        </div>

        <div id="loginErrorMessage">
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <strong>✗ خطأ!</strong> @Model.ErrorMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
        </div>

        <form id="loginForm" method="post" class="row g-3">
            <div class="col-12">
                <label asp-for="Username" class="form-label"></label>
                <input asp-for="Username" class="form-control" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" type="password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary w-100">دخول</button>
            </div>
            <div class="col-12 text-danger">
                <span asp-validation-summary="ModelOnly"></span>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const form = document.getElementById('loginForm');
            const errorContainer = document.getElementById('loginErrorMessage');

            if (window.history && window.history.pushState) {
                window.history.pushState(null, '', window.location.href);
                window.addEventListener('popstate', function () {
                    window.history.pushState(null, '', window.location.href);
                    window.location.replace('/Account/Login');
                });
            }

            if (!form) return;

            form.addEventListener('submit', async function (e) {
                e.preventDefault();
                errorContainer.innerHTML = '';

                const formData = new FormData(form);

                try {
                    const response = await fetch(form.action || window.location.href, {
                        method: 'POST',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: formData
                    });

                    const data = await response.json();
                    if (!data.success) {
                        errorContainer.innerHTML = `
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <strong>✗ خطأ!</strong> ${data.message || 'فشل تسجيل الدخول.'}
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>`;
                        return;
                    }

                    window.location.replace(data.redirectUrl || '/Employees/Index');
                } catch (error) {
                    errorContainer.innerHTML = `
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <strong>✗ خطأ!</strong> حدث خطأ أثناء محاولة تسجيل الدخول. حاول مجدداً.
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>`;
                }
            });
        })();
    </script>
}
