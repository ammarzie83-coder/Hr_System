@page
@model Hr_System.Pages.Account.LogoutModel
@{
    ViewData["Title"] = "تسجيل الخروج";
}

<div class="alert alert-info">
    جاري تسجيل الخروج، سيتم تحويلك إلى صفحة تسجيل الدخول.
</div>

@section Scripts {
    <script>
        (function () {
            if (window.history && window.history.replaceState) {
                window.history.replaceState(null, '', '/Account/Login');
            }
            window.location.replace('/Account/Login');
        })();
    </script>
}
