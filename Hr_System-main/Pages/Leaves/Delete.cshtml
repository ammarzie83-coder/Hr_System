@page "{id:int}"
@model Hr_System.Pages.Leaves.DeleteModel
@{
    ViewData["Title"] = "حذف الإجازة";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <h2>حذف الإجازة</h2>
        <div class="alert alert-warning">
            هل أنت متأكد من حذف الإجازة <strong>@Model.LeaveType</strong>؟
        </div>
        <form method="post">
            <button type="submit" class="btn btn-danger">نعم، حذف</button>
            <a asp-page="../Employees/Details" asp-route-id="@Model.EmployeeId" class="btn btn-secondary ms-2">إلغاء</a>
        </form>
    </div>
</div>
